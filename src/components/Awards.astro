---
import { siteConfig } from "../config";
const { awards, talks } = siteConfig;
---

<section id="awards" class="py-20 md:py-28 bg-[var(--color-surface)]">
  <div class="max-w-5xl mx-auto px-6">
    <div class="reveal">
      <p class="font-mono text-xs tracking-widest text-[var(--color-accent)] uppercase mb-2">Recognition & global presence</p>
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)]">Awards & Talks</h2>
      <div class="section-divider mt-3"></div>
    </div>

    <div class="mt-12 grid md:grid-cols-2 gap-10 md:gap-16">
      <!-- Talks timeline -->
      <div>
        <h3 class="reveal text-lg font-bold text-[var(--color-primary-dark)] mb-6">
          Global Presentations
          <span class="font-mono text-sm text-[var(--color-accent)] ml-2">6 countries</span>
        </h3>
        <div class="relative pl-6">
          <div class="absolute top-0 bottom-0 left-1.5 w-px bg-[var(--color-primary-light)]/30"></div>
          {talks.map((talk, i) => (
            <div class={`reveal stagger-${Math.min(i + 1, 6)} relative pb-6 last:pb-0`}>
              <div class="absolute -left-4.5 top-1 w-3 h-3 rounded-full bg-[var(--color-accent)] border-2 border-[var(--color-surface)]"></div>
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-sm font-bold text-[var(--color-accent)] shrink-0">{talk.year}</span>
                <div>
                  <p class="text-sm font-medium text-[var(--color-primary-dark)]">{talk.event}</p>
                  <p class="text-xs text-slate-500">{talk.city}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Awards cards -->
      <div>
        <h3 class="reveal text-lg font-bold text-[var(--color-primary-dark)] mb-6">Awards</h3>
        <div class="space-y-3">
          {awards.map((award, i) => (
            <div class={`reveal stagger-${Math.min(i + 1, 6)} flex items-start gap-3 bg-white rounded-xl p-4 border border-slate-200 card-hover`}>
              <div class="shrink-0 w-10 h-10 rounded-lg bg-[var(--color-accent)]/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-[var(--color-primary-dark)]">{award.title}</p>
                <p class="text-xs text-slate-500 mt-0.5">{award.where}, {award.year}</p>
                {award.amount && (
                  <span class="inline-block mt-1 font-mono text-xs text-[var(--color-accent)] font-semibold">{award.amount}</span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
