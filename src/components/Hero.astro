---
import { siteConfig } from "../config";
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-[var(--color-primary-dark)]">
  <!-- Neural Network SVG Background -->
  <svg id="neural-bg" class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <!-- Nodes -->
    <circle cx="10%" cy="20%" r="3" fill="#E8952E" opacity="0.15" class="neural-node" style="--delay: 0s; --float-y: -6px;"/>
    <circle cx="25%" cy="10%" r="2" fill="#E8952E" opacity="0.1" class="neural-node" style="--delay: 1.2s; --float-y: -10px;"/>
    <circle cx="40%" cy="30%" r="2.5" fill="#E8952E" opacity="0.12" class="neural-node" style="--delay: 0.8s; --float-y: -5px;"/>
    <circle cx="60%" cy="15%" r="3" fill="#E8952E" opacity="0.1" class="neural-node" style="--delay: 2s; --float-y: -8px;"/>
    <circle cx="75%" cy="25%" r="2" fill="#E8952E" opacity="0.15" class="neural-node" style="--delay: 0.4s; --float-y: -7px;"/>
    <circle cx="90%" cy="10%" r="2.5" fill="#E8952E" opacity="0.08" class="neural-node" style="--delay: 1.6s; --float-y: -9px;"/>
    <circle cx="15%" cy="80%" r="2" fill="#E8952E" opacity="0.1" class="neural-node" style="--delay: 0.6s; --float-y: -6px;"/>
    <circle cx="35%" cy="85%" r="3" fill="#E8952E" opacity="0.12" class="neural-node" style="--delay: 1.4s; --float-y: -5px;"/>
    <circle cx="55%" cy="75%" r="2" fill="#E8952E" opacity="0.08" class="neural-node" style="--delay: 2.2s; --float-y: -10px;"/>
    <circle cx="80%" cy="80%" r="2.5" fill="#E8952E" opacity="0.1" class="neural-node" style="--delay: 0.2s; --float-y: -7px;"/>
    <circle cx="95%" cy="70%" r="2" fill="#E8952E" opacity="0.12" class="neural-node" style="--delay: 1.8s; --float-y: -8px;"/>
    <circle cx="5%" cy="50%" r="2.5" fill="#E8952E" opacity="0.1" class="neural-node" style="--delay: 1s; --float-y: -6px;"/>
    <circle cx="50%" cy="50%" r="3" fill="#E8952E" opacity="0.06" class="neural-node" style="--delay: 0.3s; --float-y: -4px;"/>
    <circle cx="85%" cy="45%" r="2" fill="#E8952E" opacity="0.08" class="neural-node" style="--delay: 2.4s; --float-y: -9px;"/>

    <!-- Connections -->
    <line x1="10%" y1="20%" x2="25%" y2="10%" stroke="#E8952E" stroke-width="0.5" opacity="0.06" class="neural-conn" style="--delay: 0.5s;"/>
    <line x1="25%" y1="10%" x2="40%" y2="30%" stroke="#E8952E" stroke-width="0.5" opacity="0.06" class="neural-conn" style="--delay: 1s;"/>
    <line x1="40%" y1="30%" x2="60%" y2="15%" stroke="#E8952E" stroke-width="0.5" opacity="0.06" class="neural-conn" style="--delay: 1.5s;"/>
    <line x1="60%" y1="15%" x2="75%" y2="25%" stroke="#E8952E" stroke-width="0.5" opacity="0.06" class="neural-conn" style="--delay: 0.3s;"/>
    <line x1="75%" y1="25%" x2="90%" y2="10%" stroke="#E8952E" stroke-width="0.5" opacity="0.06" class="neural-conn" style="--delay: 2s;"/>
    <line x1="15%" y1="80%" x2="35%" y2="85%" stroke="#E8952E" stroke-width="0.5" opacity="0.06" class="neural-conn" style="--delay: 0.8s;"/>
    <line x1="35%" y1="85%" x2="55%" y2="75%" stroke="#E8952E" stroke-width="0.5" opacity="0.06" class="neural-conn" style="--delay: 1.3s;"/>
    <line x1="55%" y1="75%" x2="80%" y2="80%" stroke="#E8952E" stroke-width="0.5" opacity="0.06" class="neural-conn" style="--delay: 1.8s;"/>
    <line x1="5%" y1="50%" x2="10%" y2="20%" stroke="#E8952E" stroke-width="0.5" opacity="0.04" class="neural-conn" style="--delay: 0.6s;"/>
    <line x1="50%" y1="50%" x2="40%" y2="30%" stroke="#E8952E" stroke-width="0.5" opacity="0.04" class="neural-conn" style="--delay: 1.1s;"/>
    <line x1="50%" y1="50%" x2="60%" y2="15%" stroke="#E8952E" stroke-width="0.5" opacity="0.04" class="neural-conn" style="--delay: 1.6s;"/>
    <line x1="85%" y1="45%" x2="75%" y2="25%" stroke="#E8952E" stroke-width="0.5" opacity="0.04" class="neural-conn" style="--delay: 2.1s;"/>
    <line x1="85%" y1="45%" x2="95%" y2="70%" stroke="#E8952E" stroke-width="0.5" opacity="0.04" class="neural-conn" style="--delay: 0.9s;"/>
  </svg>

  <div class="relative z-10 max-w-5xl mx-auto px-6 py-20 flex flex-col md:flex-row items-center gap-10 md:gap-16">
    <!-- Photo -->
    <div class="hero-photo shrink-0">
      <div class="w-40 h-40 md:w-52 md:h-52 rounded-full overflow-hidden border-3 border-[var(--color-accent)]/40 shadow-2xl shadow-[var(--color-accent)]/10">
        <img src="/profile.jpg" alt={siteConfig.name} class="w-full h-full object-cover" width="208" height="208" />
      </div>
    </div>

    <!-- Text -->
    <div class="text-center md:text-left">
      <h1 class="hero-name text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-tight leading-tight">
        Daniel<br/>Saromo-Mori
      </h1>
      <div class="hero-tagline mt-3 h-0.5 w-16 mx-auto md:mx-0 bg-[var(--color-accent)] rounded"></div>
      <div class="hero-subtitles mt-4 space-y-1">
        {siteConfig.subtitles.map((sub) => (
          <p class="text-sm md:text-base text-slate-400">{sub}</p>
        ))}
      </div>

      <!-- Stats -->
      <div class="hero-stats mt-8 grid grid-cols-2 md:grid-cols-4 gap-4">
        {siteConfig.stats.map((stat) => (
          <div class="text-center px-3 py-3 rounded-lg bg-[var(--color-primary)]/60 border border-[var(--color-primary-light)]/20">
            <div class="font-mono text-xl md:text-2xl font-bold text-[var(--color-accent)]" data-count={stat.value}>
              {stat.value}
            </div>
            <div class="text-xs text-slate-500 mt-1">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40">
    <span class="text-xs text-slate-500 tracking-widest uppercase">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-[var(--color-accent)] to-transparent"></div>
  </div>
</section>

<style>
  .neural-node {
    animation: nodeFloat 6s ease-in-out infinite, nodePulse 4s ease-in-out infinite;
    animation-delay: var(--delay);
  }
  .neural-conn {
    animation: connectionGlow 5s ease-in-out infinite;
    animation-delay: var(--delay);
  }
  @keyframes nodeFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(var(--float-y, -6px)); }
  }
  @keyframes nodePulse {
    0%, 100% { opacity: 0.1; }
    50% { opacity: 0.35; }
  }
  @keyframes connectionGlow {
    0%, 100% { opacity: 0.04; }
    50% { opacity: 0.15; }
  }
</style>
