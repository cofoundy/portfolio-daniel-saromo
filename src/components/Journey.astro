---
import { siteConfig } from "../config";
const { journey } = siteConfig;
---

<section id="journey" class="py-20 md:py-28 bg-[var(--color-primary-dark)]">
  <div class="max-w-5xl mx-auto px-6">
    <div class="reveal">
      <p class="font-mono text-xs tracking-widest text-[var(--color-accent)] uppercase mb-2">4 Countries, 4 Institutions</p>
      <h2 class="text-3xl md:text-4xl font-bold text-white">Research Journey</h2>
      <div class="section-divider mt-3"></div>
    </div>

    <!-- Desktop: Horizontal timeline -->
    <div class="hidden md:block mt-16">
      <div class="relative">
        <!-- Horizontal line -->
        <div class="absolute top-6 left-0 right-0 h-px bg-[var(--color-primary-light)]/40"></div>

        <div class="grid grid-cols-4 gap-6">
          {journey.map((stop, i) => (
            <div class={`reveal stagger-${i + 1} relative pt-12`}>
              <!-- Dot -->
              <div class="absolute top-3 left-1/2 -translate-x-1/2 w-6 h-6 rounded-full bg-[var(--color-accent)] border-4 border-[var(--color-primary-dark)] z-10"></div>

              <!-- Card -->
              <div class="bg-[var(--color-primary)]/60 border border-[var(--color-primary-light)]/20 rounded-xl p-5 card-hover">
                <div class="text-2xl mb-1">{stop.flag}</div>
                <h3 class="text-lg font-bold text-white">{stop.city}</h3>
                <p class="font-mono text-xs text-[var(--color-accent)] mt-1">{stop.institution}</p>
                <p class="text-sm text-slate-400 mt-0.5">{stop.degree}</p>
                <p class="text-xs text-slate-500 mt-1">{stop.period}</p>
                <ul class="mt-3 space-y-1">
                  {stop.highlights.map((h) => (
                    <li class="text-xs text-slate-400 flex items-start gap-1.5">
                      <span class="mt-1 w-1 h-1 rounded-full bg-[var(--color-accent)]/60 shrink-0"></span>
                      {h}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Mobile: Vertical timeline -->
    <div class="md:hidden mt-10">
      <div class="relative pl-8">
        <!-- Vertical line -->
        <div class="absolute top-0 bottom-0 left-3 w-px bg-[var(--color-primary-light)]/30"></div>

        <div class="space-y-8">
          {journey.map((stop, i) => (
            <div class={`reveal stagger-${i + 1} relative`}>
              <!-- Dot -->
              <div class="absolute -left-5 top-1 w-4 h-4 rounded-full bg-[var(--color-accent)] border-3 border-[var(--color-primary-dark)] z-10"></div>

              <div class="bg-[var(--color-primary)]/40 border border-[var(--color-primary-light)]/15 rounded-xl p-4">
                <div class="flex items-center gap-2">
                  <span class="text-xl">{stop.flag}</span>
                  <div>
                    <h3 class="text-base font-bold text-white">{stop.city}</h3>
                    <p class="font-mono text-xs text-[var(--color-accent)]">{stop.institution} · {stop.period}</p>
                  </div>
                </div>
                <p class="text-sm text-slate-400 mt-2">{stop.degree}</p>
                <ul class="mt-2 space-y-1">
                  {stop.highlights.map((h) => (
                    <li class="text-xs text-slate-400 flex items-start gap-1.5">
                      <span class="mt-1 w-1 h-1 rounded-full bg-[var(--color-accent)]/60 shrink-0"></span>
                      {h}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
